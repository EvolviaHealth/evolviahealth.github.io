# Configuration PUBLIQUE du build (Next.js) — aucun secret ici.
# Clé publique Web3Forms : relie le formulaire de contact à la boîte
# evolviahealth@outlook.fr. Chaque envoi du formulaire y arrive automatiquement.
# (Web3Forms indique explicitement que cette clé est publique / côté client.)
NEXT_PUBLIC_WEB3FORMS_KEY=faf36b57-210b-4415-9a62-fa76a2cc2cb5

# Calendrier de rendez-vous Cal.com affiché sur la page « Prendre rendez-vous »
# (lien public de l'événement, format « compte/evenement »).
NEXT_PUBLIC_CAL_LINK=evolvia/30min
